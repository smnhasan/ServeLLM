# Copy to .env and adjust.
DEBUG=false

# Comma-separated API keys (SHA-256 hex digests when AUTH_USE_HASHED=true)
VALID_API_KEYS=sk-llmserve-test-key-1234
AUTH_USE_HASHED=false

RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPM=60

MODELS_CONFIG_PATH=configs/models.yaml

# true = no real model is loaded; responses are simulated
DUMMY_MODE=false
DUMMY_LATENCY_MS=200
STREAM_CHUNK_DELAY_MS=50

# Local inference (used when DUMMY_MODE=false)
LLM_MODEL_REPO=ggml-org/gpt-oss-20b-GGUF
LLM_MODEL_FILE=gpt-oss-20b-mxfp4.gguf
LLM_MODEL_ID=gpt-oss-20b
LLM_N_CTX=10048
LLM_N_GPU_LAYERS=-1
MAX_CONCURRENT_REQUESTS=3
